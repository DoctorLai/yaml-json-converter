{
  "name": "yaml-json-converter",
  "version": "1.1.0",
  "description": "A simple, fast web-based tool to convert YAML to JSON and vice versa, built with React + Vite.",
  "type": "module",
  "keywords": [
    "yaml",
    "json",
    "converter",
    "yaml-to-json",
    "json-to-yaml",
    "react",
    "vite"
  ],
  "homepage": "https://doctorlai.github.io/yaml-json-converter",
  "bugs": {
    "url": "https://github.com/DoctorLai/yaml-json-converter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoctorLai/yaml-json-converter.git"
  },
  "license": "MIT",
  "author": "DoctorLai (https://github.com/doctorlai)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check 'src/**/*.{js,jsx}' 'tests/**/*.{js,jsx}'",
    "format:fix": "prettier --write 'src/**/*.{js,jsx}' 'tests/**/*.{js,jsx}'",
    "check": "npm run format && npm run lint && npm run coverage && npm run build",
    "deploy": "npm run add-version && npm run build && gh-pages -d dist",
    "add-version": "echo \"VITE_COMMIT_HASH=$(git rev-parse --short HEAD)\" > .env"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}
