# Normalize line endings to LF on checkin, auto-detect text files
* text=auto eol=lf

# Explicitly declare text files
*.js    text
*.jsx   text
*.json  text
*.css   text
*.html  text
*.md    text
*.yml   text
*.yaml  text
*.svg   text

# Binary assets (never normalize)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary

# Generated files: collapse in diffs and exclude from language stats
package-lock.json linguist-generated=true
dist/**           linguist-generated=true
coverage/**       linguist-generated=true
